{$APP_ADDRESS} {
 encode zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy no-referrer
  X-Frame-Options DENY
  Permissions-Policy "camera=(self), microphone=(), geolocation=()"
 }
 @selfie path /api/v1/auth/register /api/v1/auth/sca/kyc /api/v1/open-banking/consents/*/sign
 @noSelfie not path /api/v1/auth/register /api/v1/auth/sca/kyc /api/v1/open-banking/consents/*/sign
 request_body @noSelfie {
  max_size 128KB
 }
 request_body @selfie {
  max_size 600KB
 }
 handle /api/* {
  header Cache-Control "no-store"
  reverse_proxy api:8080
 }
 handle /card-form/* {
  header Cache-Control "no-store"
  reverse_proxy sim:8081
 }
 handle /ob-consent/* {
  header Cache-Control "no-store"
  reverse_proxy sim:8081
 }
 handle {
  reverse_proxy mobile:8082
 }
}
{$ADMIN_ADDRESS} {
 encode zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy no-referrer
  X-Frame-Options DENY
 }
 request_body {
  max_size 128KB
 }
 handle /api/* {
  header Cache-Control "no-store"
  reverse_proxy api:8080
 }
 handle {
  reverse_proxy admin:3000
 }
}
